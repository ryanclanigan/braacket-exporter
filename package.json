{
  "name": "braacket-replacement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "PATH=/usr/local/go/bin:$PATH go run ./cmd/server",
    "discover": "PATH=/usr/local/go/bin:$PATH go run ./cmd/sync discover",
    "sync": "PATH=/usr/local/go/bin:$PATH go run ./cmd/sync",
    "reconcile": "PATH=/usr/local/go/bin:$PATH go run ./cmd/reconcile",
    "rank": "PATH=/usr/local/go/bin:$PATH go run ./cmd/rank",
    "test:go": "PATH=/usr/local/go/bin:$PATH go test ./...",
    "test:ui": "playwright test",
    "test": "npm run test:go && npm run test:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "playwright": "^1.61.0"
  }
}
